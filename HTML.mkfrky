import telebotimport timefrom telebot import typestoken = '8361261182:AAHAzIwRMbboHVP-2gIAsepLAwh0s33dyYQ'bot = telebot.TeleBot(token)# زر البداية@bot.message_handler(commands=['start'])def start(message):    markup = types.ReplyKeyboardMarkup(resize_keyboard=True)    btn1 = types.KeyboardButton("📱 فحص رقم")    btn2 = types.KeyboardButton("ℹ️ معلومات البوت")    markup.add(btn1, btn2)    bot.send_message(message.chat.id,    "🔥 مرحباً بك في بوت فحص الأرقام اليمنية المتطور\n\nاختر من القائمة 👇",    reply_markup=markup)# معلومات البوت@bot.message_handler(func=lambda m: m.text == "ℹ️ معلومات البوت")def info(message):    bot.send_message(message.chat.id,    "🤖 بوت احترافي لفحص الأرقام اليمنية\n"    "📡 يكشف شركة الاتصالات + معلومات متقدمة\n"    "⚡ سرعة + دقة + تصميم خرافي")# طلب إدخال رقم@bot.message_handler(func=lambda m: m.text == "📱 فحص رقم")def ask_number(message):    bot.send_message(message.chat.id, "📥 أرسل الرقم الآن مثل:\n77xxxxxxx")# الفحص@bot.message_handler(func=lambda message: True)def check(message):    num = message.text.strip()    # تحقق من الرقم    if not num.isdigit() or len(num) < 9:        bot.reply_to(message, "❌ الرقم غير صحيح، حاول مرة أخرى")        return    msg = bot.reply_to(message, "⏳ جاري الفحص ...")    time.sleep(2)    # تحديد الشركة    company = "غير معروف ❌"    if num.startswith(("77","78")):        company = "📡 YOU (MTN سابقاً)"    elif num.startswith(("71","73")):        company = "📡 سبأفون"    elif num.startswith("70"):        company = "📡 يمن موبايل"    elif num.startswith("79"):        company = "📡 واي"    # تحويل دولي    if num.startswith("0"):        international = "+967" + num[1:]    else:        international = "+967" + num    # حالة الرقم (تقريبية)    status = "✅ صالح" if len(num) == 9 else "⚠️ غير مكتمل"    result = f"""╭━━━〔 ⚡ فحص رقم احترافي 〕━━━╮📞 الرقم: {num}🌍 الدولة: اليمن 🇾🇪📡 الشركة: {company}📲 دولي: {international}📊 معلومات إضافية:🔢 عدد الأرقام: {len(num)}📶 الحالة: {status}╰━━━━━━━━━━━━━━━━━━━━╯👨‍💻 BY: عبدالرحيم 😎"""    bot.edit_message_text(result, message.chat.id, msg.message_id)bot.polling()